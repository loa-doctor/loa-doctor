  const [rawHp, setRawHp] = useState<number>(0)
  const [filteredHp, setFilteredHp] = useState<number>(0)
  const [analysisStatus, setAnalysisStatus] = useState<AnalysisStatus>('IDLE')
  const [currentGuide, setCurrentGuide] = useState({
