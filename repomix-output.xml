<file path="client/src/features/screen-capture/utils/rect.ts">
import { Rect, Aspect } from './types'

/* =====================================================
 * 기본 Rect 계산 (Aspect 기반)
 * ===================================================== */

/**
 * 주어진 frame 안에서 특정 비율(16:9 / 21:9)의
 * 가장 큰 중앙 Rect 계산
 */
export function calcLargestRect(frameW: number, frameH: number, aspect: Aspect): Rect | null {
  const ratio = aspect === '21:9' ? 21 / 9 : aspect === '16:9' ? 16 / 9 : 0

  if (!ratio) return null

  let w = frameW
  let h = Math.floor(w / ratio)

  if (h > frameH) {
    h = frameH
    w = Math.floor(h * ratio)
  }

  if (w <= 0 || h <= 0) return null

  return {
    aspect,
    x: Math.floor((frameW - w) / 2),
    y: Math.floor((frameH - h) / 2),
    w,
    h,
  }
}

/**
 * 16:9 / 21:9 중 면적이 더 큰 Rect 선택
 */
export function pickBestRect(frameW: number, frameH: number): Rect | null {
  const r21 = calcLargestRect(frameW, frameH, '21:9')
  const r16 = calcLargestRect(frameW, frameH, '16:9')

  const list = [r21, r16].filter(Boolean) as Rect[]
  if (!list.length) return null

  return list.reduce((a, b) => (a.w * a.h > b.w * b.h ? a : b))
}

/* =====================================================
 * 애니메이션 보간
 * ===================================================== */

export function lerp(a: number, b: number, t: number) {
  return a + (b - a) * t
}

export function lerpRect(from: Rect, to: Rect, t: number): Rect {
  return {
    aspect: to.aspect,
    x: Math.round(lerp(from.x, to.x, t)),
    y: Math.round(lerp(from.y, to.y, t)),
    w: Math.round(lerp(from.w, to.w, t)),
    h: Math.round(lerp(from.h, to.h, t)),
  }
}

/* =====================================================
 * Rect Tuning (미세 조정)
 * ===================================================== */

export type RectTuning = {
  scale: number // 0.05 ~ 1.0
  padX: number // px
  padY: number // px
  offXRatio: number // -0.5 ~ 0.5
  offYRatio: number // -0.5 ~ 0.5
  threshold: number // 10 ~ 50
}

/**
 * LOCK된 기준 Rect에 미세 조정 적용
 */
export function applyTuning(base: Rect, frameW: number, frameH: number, tuning: RectTuning): Rect {
  // scale
  const scaledW = Math.round(base.w * tuning.scale)
  const scaledH = Math.round(base.h * tuning.scale)

  // center
  const cx = base.x + base.w / 2
  const cy = base.y + base.h / 2

  // offset (ratio → px)
  const offXPx = Math.round(base.w * tuning.offXRatio)
  const offYPx = Math.round(base.h * tuning.offYRatio)

  // position
  let x = Math.round(cx - scaledW / 2) + offXPx + tuning.padX
  let y = Math.round(cy - scaledH / 2) + offYPx + tuning.padY
  let w = scaledW - tuning.padX * 2
  let h = scaledH - tuning.padY * 2

  // minimum
  if (w < 1) w = 1
  if (h < 1) h = 1

  // clamp
  if (x < 0) x = 0
  if (y < 0) y = 0
  if (x + w > frameW) w = frameW - x
  if (y + h > frameH) h = frameH - y

  return {
    aspect: base.aspect,
    x,
    y,
    w,
    h,
  }
}
</file>

<file path="README.md">
# 🩺 LOA Doctor

**LOA Doctor**는  
로스트아크 플레이 중 **실시간 화면 공유를 기반으로 보스 UI를 분석**하고,  
현재 상황에 맞는 **공략 정보를 Picture-in-Picture(PiP)** 형태로 제공하는 웹 서비스입니다.

로아를 하는데 있어서 가장 큰 장벽인 트라이의 두려움을 줄이고자 도움을 받을 수 있는 사이트를 개발하기로 하였습니다.

---

## 🎯 프로젝트 목표

- 로스트아크 보스전 중 **실시간 화면 트래킹**
- 보스 체력, 패턴 구간 등 **시각 정보 자동 인식**
- 상황에 맞는 **공략 가이드 즉시 제공**
- 게임 플레이 흐름을 방해하지 않는 **PiP UI 제공**

---

## 🧠 핵심 아이디어

1. **WebRTC 화면 공유**
   - 사용자가 브라우저를 통해 게임 화면을 공유
2. **실시간 화면 분석**
   - OpenCV 기반으로 보스 HP 바, 패턴 전환 시점 등을 인식
3. **공략 매칭**
   - 현재 보스 상태에 맞는 공략 데이터 매칭
4. **Picture-in-Picture 출력**
   - 영상 위가 아닌, OS 레벨 PiP로 공략 정보 표시

---

## 🛠 기술 스택

### Frontend
- **Next.js**
- **TypeScript**
- **Tailwind CSS**
- WebRTC (getDisplayMedia, RTCPeerConnection)
- Picture-in-Picture API

### Backend
- **Node.js (Express)**
- WebRTC Signaling
- OpenCV (영상 프레임 분석)
- (Optional) Worker / Queue 구조

### Database
- **MongoDB** (예정)
  - 보스 정보
  - 패턴 타이밍
  - 공략 데이터

---

## 🚀 개발 단계 로드맵

### Phase 1 – 기본 동작
- [ ] WebRTC 화면 공유 연결
- [ ] 서버로 영상 스트림 전달
- [ ] PiP 기반 UI 출력

### Phase 2 – 인식 & 분석
- [ ] 보스 HP 바 영역 검출
- [ ] 체력 구간별 상태 분기
- [ ] 프레임 샘플링 최적화

### Phase 3 – 공략 연동
- [ ] 보스별 공략 데이터 설계
- [ ] 상태 → 공략 매칭 로직
- [ ] PiP 내 단계별 가이드 표시

### Phase 4 – 확장
- [ ] 보스 선택 자동 인식
- [ ] 사용자 커스터마이징
- [ ] 성능 최적화 및 배포

---

## ⚠️ 참고 사항

- 본 프로젝트는 **개인 학습 및 기술 실험 목적**으로 진행됩니다.
- 게임 클라이언트에 직접적인 개입은 하지 않습니다.
- 모든 분석은 **사용자가 공유한 화면 데이터 기반**으로만 이루어집니다.

---

## ✨ Motivation

LOA Doctor는  
게임을 더 잘 ‘외우기’ 위한 도구가 아니라,  
플레이어가 **판단에만 집중할 수 있도록 돕는 보조 시스템**을 지향합니다.
</file>

